import pandas as pd

orders = pd.read_csv('orders.csv')
orders.columns = [col.lower().strip() for col in orders.columns]

print("Orders shape:", orders.shape)
print(orders.info())
print(orders.head())
# %%
# %%
# Merge orders with order_products_prior
df_merged = pd.merge(order_products_prior, orders, on='order_id', how='inner')

# Merge with products table to get product details, aisles, and departments
df_merged = pd.merge(df_merged, products, on='product_id', how='inner')
df_merged = pd.merge(df_merged, aisles, on='aisle_id', how='inner')
df_merged = pd.merge(df_merged, departments, on='department_id', how='inner')

print("Merged Dataframe shape:", df_merged.shape)
print(df_merged.head(2))
# %%
# %%
# تنظيم جدول الحقائق وجداول الأبعاد (Dimensions & Facts Schema)
dim_orders = orders.copy()
dim_products = products.copy()
dim_aisles = aisles.copy()
dim_departments = departments.copy()

# تجهيز جدول الحقائق النهائي للتحليل
fact_order_products = order_products_prior.copy()

print("Schema Tables Ready:")
print("- dim_orders shape:", dim_orders.shape)
print("- dim_products shape:", dim_products.shape)
print("- fact_order_products shape:", fact_order_products.shape)
