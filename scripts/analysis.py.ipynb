import pandas as pd

# Keep only essential columns in the fact table to reduce size and prevent lag
fact_order_products_slim = fact_order_products[['order_id', 'product_id', 'add_to_cart_order', 'reordered']].copy()

# Export optimized and clean schema tables for Power BI
dim_orders.to_csv('dim_orders.csv', index=False)
dim_products.to_csv('dim_products.csv', index=False)
dim_aisles.to_csv('dim_aisles.csv', index=False)
dim_departments.to_csv('dim_departments.csv', index=False)
fact_order_products_slim.to_csv('fact_order_products.csv', index=False)

print("Optimized schema tables exported successfully for Power BI!")
print("Slim Fact Shape:", fact_order_products_slim.shape)
