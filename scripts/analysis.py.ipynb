import pandas as pd

# 1. Dim Users / Customers (from orders)
dim_users = orders[['user_id']].drop_duplicates().copy()
dim_users['customer_segment'] = 'Standard'

# 2. Dim Time / Calendar (from orders: order_dow, order_hour_of_day)
dim_time = orders[['order_dow', 'order_hour_of_day']].drop_duplicates().copy()
dim_time['time_id'] = range(len(dim_time))

# 3. Dim Order Status / Evaluation Set
dim_order_status = orders[['eval_set']].drop_duplicates().copy()
dim_order_status['status_id'] = range(len(dim_order_status))

# 4. Dim Products (enhanced)
dim_products = products.copy()

# 5. Dim Aisles
dim_aisles = aisles.copy()

# 6. Dim Departments
dim_departments = departments.copy()

# 7. Fact Orders (main orders header)
fact_orders = orders[['order_id', 'user_id', 'order_number', 'order_dow', 'order_hour_of_day', 'days_since_prior_order']].copy()

# 8. Fact Order Products (line items)
fact_order_products_slim = fact_order_products[['order_id', 'product_id', 'add_to_cart_order', 'reordered']].copy()

# 9. Fact User Behavior (summary of user ordering patterns)
fact_user_behavior = orders.groupby('user_id').agg(
    total_orders=('order_id', 'count'),
    avg_days_between_orders=('days_since_prior_order', 'mean')
).reset_index()

# 10. Fact Product Popularity
fact_product_popularity = fact_order_products.groupby('product_id').agg(
    total_ordered_times=('order_id', 'count'),
    total_reorders=('reordered', 'sum')
).reset_index()

