import pandas as pd
import os

print("Files in directory:", os.listdir('.'))

products = pd.read_csv('products.csv')
aisles = pd.read_csv('aisles.csv')
departments = pd.read_csv('departments.csv')

# التأكد من اسم ملف الـ order_products الصحيح
try:
    order_products_prior = pd.read_csv('order_products_prior.csv')
except FileNotFoundError:
    order_products_prior = pd.read_csv('order_products__prior.csv')

for df in [products, aisles, departments, order_products_prior]:
    df.columns = [col.lower().strip() for col in df.columns]

print("Success! Products shape:", products.shape)
print("Order Products shape:", order_products_prior.shape)
